---
import { CAMERAS, archive } from '../config/cameras';

const links = (id: string, archiveUrl: string) => [
  { label: 'Live', href: `/${id}` },
  { label: 'Timelapse', href: `/timelapse?camera=${id}` },
  { label: 'Image Only', href: `/image-only?camera=${id}` },
  { label: 'Archive', href: archiveUrl, external: true },
];
---

<header
  class="sticky top-0 z-50 border-b border-brand-600/30 bg-brand-500 text-brand-950 shadow-sm"
>
  <nav class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2.5">
      <img
        src="/img/corolive64.webp"
        alt=""
        width="32"
        height="32"
        class="rounded-md"
      />
      <span class="text-lg font-extrabold tracking-tight">CoroLive</span>
    </a>

    <span class="hidden text-sm font-medium text-brand-950/60 lg:inline">
      The Coromandel&rsquo;s Live Webcam Network
    </span>

    <!-- Desktop: one dropdown per camera -->
    <ul class="ml-auto hidden items-center gap-1 md:flex">
      {
        CAMERAS.map((c) => (
          <li class="relative" data-dropdown>
            <button
              type="button"
              class="flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-semibold transition-colors hover:bg-brand-950/10 aria-expanded:bg-brand-950/10"
              aria-expanded="false"
              data-dropdown-trigger
            >
              {c.name}
              <svg
                class="size-3.5 opacity-70 transition-transform"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
                data-dropdown-chevron
              >
                <path
                  fill-rule="evenodd"
                  d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                  clip-rule="evenodd"
                />
              </svg>
            </button>

            <ul
              class="absolute right-0 mt-1 hidden w-44 overflow-hidden rounded-xl border border-edge bg-surface py-1 shadow-lg"
              data-dropdown-menu
            >
              {links(c.id, archive(c)).map((l) => (
                <li>
                  <a
                    href={l.href}
                    target={l.external ? '_blank' : undefined}
                    rel={l.external ? 'noopener' : undefined}
                    class="block px-3.5 py-2 text-sm font-medium text-ink transition-colors hover:bg-surface-2"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
      <li>
        <a
          href="/embedding"
          class="rounded-lg px-3 py-2 text-sm font-semibold transition-colors hover:bg-brand-950/10"
          >Embedding</a
        >
      </li>
    </ul>

    <!-- Mobile: single toggle, everything expanded (no nested menus) -->
    <button
      type="button"
      class="ml-auto rounded-lg p-2 transition-colors hover:bg-brand-950/10 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation"
      data-menu-trigger
    >
      <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="hidden border-t border-brand-600/30 bg-brand-500 px-4 pb-4 md:hidden"
    data-menu
  >
    {
      CAMERAS.map((c) => (
        <div class="pt-3">
          <p class="px-1 pb-1 text-xs font-bold tracking-wider text-brand-950/60 uppercase">
            {c.name}
          </p>
          <ul class="grid grid-cols-2 gap-1">
            {links(c.id, archive(c)).map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noopener' : undefined}
                  class="block rounded-lg px-3 py-2 text-sm font-semibold transition-colors hover:bg-brand-950/10"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <a
      href="/embedding"
      class="mt-3 block rounded-lg px-3 py-2 text-sm font-semibold transition-colors hover:bg-brand-950/10"
      >Embedding</a
    >
  </div>
</header>

<script>
  // Replaces bootstrap.bundle.min.js - the only two behaviours the old navbar
  // used it for were dropdown toggling and the mobile collapse.
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');

  function closeAll(except?: Element) {
    for (const d of dropdowns) {
      if (d === except) continue;
      d.querySelector('[data-dropdown-menu]')?.classList.add('hidden');
      d.querySelector('[data-dropdown-trigger]')?.setAttribute('aria-expanded', 'false');
      d.querySelector('[data-dropdown-chevron]')?.classList.remove('rotate-180');
    }
  }

  for (const d of dropdowns) {
    const trigger = d.querySelector<HTMLButtonElement>('[data-dropdown-trigger]')!;
    const menu = d.querySelector<HTMLElement>('[data-dropdown-menu]')!;
    const chevron = d.querySelector<HTMLElement>('[data-dropdown-chevron]')!;

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = menu.classList.contains('hidden');
      closeAll(d);
      menu.classList.toggle('hidden', !open);
      chevron.classList.toggle('rotate-180', open);
      trigger.setAttribute('aria-expanded', String(open));
    });
  }

  document.addEventListener('click', () => closeAll());
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });

  const menuTrigger = document.querySelector<HTMLButtonElement>('[data-menu-trigger]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-menu]');
  menuTrigger?.addEventListener('click', () => {
    const open = mobileMenu!.classList.toggle('hidden');
    menuTrigger.setAttribute('aria-expanded', String(!open));
  });
</script>
