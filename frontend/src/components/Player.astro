---
interface Props {
  source: string;
  poster: string;
  /** Only the embeddable player is watermarked. */
  watermark?: boolean;
}

const { source, poster, watermark = false } = Astro.props;
---

<div class="relative aspect-video w-full overflow-hidden rounded-xl bg-black">
  <!-- Native controls: hls.js is a stream loader, not a UI, and the browser's
       own chrome brings fullscreen, picture-in-picture and AirPlay for free. -->
  <video
    data-player
    data-source={source}
    data-poster={poster}
    class="block size-full"
    controls
    autoplay
    muted
    playsinline></video>

  {
    watermark && (
      <a
        href="https://corolive.nz"
        target="_blank"
        rel="noopener"
        class="absolute right-3 bottom-14 opacity-80 transition-opacity hover:opacity-100"
      >
        <img src="https://corolive.nz/img/watermark.webp" alt="CoroLive" class="h-8 w-auto" />
      </a>
    )
  }
</div>

<script>
  import { attachStream } from '../lib/hls';

  const video = document.querySelector<HTMLVideoElement>('[data-player]');

  if (video) {
    // Busted per load so the still frame is current, not whatever the CDN
    // last cached - the poster only shows until the stream starts.
    video.poster = `${video.dataset.poster}?rand=${Math.random()}`;
    attachStream(video, video.dataset.source!);
  }
</script>
