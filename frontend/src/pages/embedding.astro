---
import Base from '../layouts/Base.astro';
import { CAMERAS } from '../config/cameras';

const snippet =
  '<iframe width="640" height="360" src="https://corolive.nz/embed?camera=CAMERA-ID"></iframe>';

const CODE = 'rounded bg-surface-2 px-1.5 py-0.5 text-xs';

// The camera list reads as prose ("either a, b, or c"). Built here rather than
// in the markup so the separators don't pick up whitespace from indentation.
const cameraList = CAMERAS.map((c, i) => {
  const sep = i === 0 ? '' : i === CAMERAS.length - 1 ? ', or ' : ', ';
  return `${sep}<code class="${CODE}">${c.id}</code>`;
}).join('');
---

<Base
  title="Embedding - CoroLive"
  description="How to embed a CoroLive webcam on your own website using an HTML iframe."
>
  <div class="mx-auto max-w-3xl px-4 py-12 text-center sm:px-6">
    <h1 class="text-3xl font-extrabold sm:text-4xl">Embedding</h1>

    <p class="mt-6 text-pretty text-muted">
      So you want to embed CoroLive on your own website?<br />
      Great, there&rsquo;s some details you should know before going ahead!
    </p>

    <p class="mt-6 text-pretty text-muted">
      The easiest way to get started is to create an HTML iframe with the embed URL.
    </p>

    <p class="mt-6 text-muted">Here&rsquo;s an example:</p>
    <pre
      class="mt-3 rounded-xl border border-edge bg-surface-2 p-4 text-left text-sm break-words whitespace-pre-wrap"><code>{snippet}</code></pre>

    <p class="mt-6 text-pretty text-muted">
      Then simply replace <code class={CODE}>CAMERA-ID</code> with either <Fragment
        set:html={cameraList}
      />.
    </p>

    <p class="mt-6 text-sm text-muted">
      You can learn more about the HTML iframe by <a
        href="https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe"
        class="font-medium text-brand-700 hover:underline dark:text-brand-400"
        >clicking here</a
      >.
    </p>

    <section class="card mt-10 border-brand-500/40 p-5">
      <h2 class="text-lg font-bold">Lastly, and most importantly&hellip;</h2>
      <p class="mt-2 text-pretty text-muted">
        &hellip;reach out and let me know you&rsquo;re going to embed CoroLive, this means
        I can keep track and whitelist your website. See below for contact details.
      </p>
    </section>
  </div>
</Base>
