---
import Base from '../layouts/Base.astro';
import { API, CAMERAS } from '../config/cameras';

// These pages resolve their camera from ?camera=, so every visible string is
// client-side. A bundled <script> is deferred, which meant the generic heading
// painted first and was then swapped - so both scripts here are inline and run
// during parse instead.
const cameraNames = Object.fromEntries(CAMERAS.map((c) => [c.id, c.name]));
const cfg = { api: API, names: cameraNames };
---

<Base title="Image Only - CoroLive">
  <!-- Reject unknown cameras before the body paints, as the old page did. -->
  <script is:inline slot="head" define:vars={{ cameraNames }}>
    var camera = new URLSearchParams(location.search).get('camera');
    if (!Object.prototype.hasOwnProperty.call(cameraNames, camera)) location.replace('/');
    else document.title = cameraNames[camera] + ' Image Only - CoroLive';
  </script>

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    <h1 class="mb-5 text-3xl font-extrabold sm:text-4xl" data-heading></h1>

    <div class="aspect-video w-full overflow-hidden bg-surface-2">
      <img
        data-frame
        alt=""
        class="size-full object-cover opacity-0 transition-opacity duration-300"
      />
    </div>

    <p class="mt-4 text-sm text-muted">
      A plain refreshing still image, for slow connections and devices that
      can&rsquo;t handle the live video stream. Updates every 15 seconds.
    </p>
  </div>

  <!-- define:vars wraps each script in its own IIFE, so the camera is resolved
       again here rather than shared with the one in the head. -->
  <script is:inline define:vars={{ cfg }}>
    var camera = new URLSearchParams(location.search).get('camera');
    if (Object.prototype.hasOwnProperty.call(cfg.names, camera)) {
      var name = cfg.names[camera];

      document.querySelector('[data-heading]').textContent = name + ' Image Only';

      var img = document.querySelector('[data-frame]');
      img.alt = 'Latest still image from the ' + name + ' camera';
      // Fade the first frame in rather than popping it over the placeholder.
      img.addEventListener('load', function () {
        img.classList.remove('opacity-0');
      });

      var refresh = function () {
        img.src = cfg.api + '/' + camera + '/snap.webp?rand=' + Math.random();
      };
      refresh();
      setInterval(refresh, 15000);
    }
  </script>
</Base>
